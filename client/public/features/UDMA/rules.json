{
  "meta": {
    "source": "UD&MA Smart DCR User Manual Version 10.0 (Vinzas Solutions India Private Limited)",
    "manualVersion": "10.0",
    "manualDate": "17_08_2026",
    "scope": "Pre-Check geometry/format compliance only; the manual states that Pre-Check does not scrutinize building regulations.",
    "rulesVersion": "3.0.0-manual-v10",
    "note": "Rule entries transcribed from Version 10.0 Section 4.0 and Sections 5.0–17.3. Combined table rows retain grouped descriptions where the manual groups multiple values. Null colors indicate multiple distinct colors listed within one row; see notes. Exact colorVariants are supplied for grouped multi-color rows. A null color means the table row has multiple different colors, not that color is optional.",
    "sourceSections": [
      "Sections 3.0–3.1.2",
      "Section 4.0 (printed pages 7–17)",
      "Sections 5.0–16.0 (printed pages 18–20)",
      "Annexure 17.1–17.3 (printed pages 22–122)"
    ]
  },
  "settings": {
    "processedLayerPrefix": "FLOOR",
    "otherLayersIgnored": true,
    "units": {
      "required": "metres",
      "scale": "1:1"
    },
    "minTextHeightExclusive": 0.05,
    "textMustBeSingleLine": true,
    "modelSpaceOnly": true,
    "allowedEntityTypes": [
      "LINE",
      "LWPOLYLINE",
      "TEXT"
    ],
    "forbiddenEntityTypes": [
      "INSERT",
      "REGION",
      "WIPEOUT",
      "OLE2FRAME",
      "MTEXT",
      "POLYLINE_3D",
      "XREF"
    ],
    "forbiddenNote": "Blocks, Regions, Wipeouts and External references shall not be placed; OLE objects shall not be used; MTEXT is not processed; 3D polylines are not supported.",
    "unlistedEntityTypes": "warn",
    "entityProperties": {
      "zCoordinate": 0,
      "elevation": 0,
      "thickness": 0,
      "globalWidth": 0,
      "lineweight": 0
    },
    "polylinesMustBeClosedDefault": null,
    "closedNote": "The manual says the Pre-Check verifies closed polylines but Section 4.0 also expressly specifies open polylines for Width of Plot and travel distances. Apply closure checks by individual object semantics; do not blanket-close every polyline.",
    "boundingRectangle": {
      "type": "LWPOLYLINE",
      "lowerLeftCorner": [
        0,
        0,
        0
      ],
      "objectsOutsideIgnored": true
    },
    "compulsoryLabels": [
      "all floors",
      "all blocks",
      "building use"
    ],
    "colorMode": "not_specified_by_manual",
    "drawingPreparation": [
      "Put the entire drawing in layer 0 before creating Smart DCR layers.",
      "Only color-coded objects intended for processing are to be placed in layers starting with FLOOR.",
      "Unlock, unfreeze and turn on layers before submission; purge unwanted layers.",
      "Do not overlap objects or add unnecessary polyline coordinates."
    ],
    "caseInsensitiveLayerNames": null,
    "caseInsensitiveText": null,
    "colorModeNote": "The manual gives color-code numbers but does not specify whether ByLayer, ByBlock or true-colour assignments are accepted.",
    "caseNote": "The manual does not state case-sensitivity rules."
  },
  "layerRules": {
    "caseInsensitive": true,
    "patterns": [
      {
        "id": "L-FLOORNN",
        "regex": "^FLOOR\\d{2,}$",
        "kind": "applicable_floor",
        "meaning": "Any recognized applicable floor layer; applies to all floor categories, not only numbered FLOORnn layers."
      },
      {
        "id": "L-GROUND",
        "regex": "^FLOOR-GROUND$",
        "kind": "ground",
        "meaning": "Common site-related details"
      },
      {
        "id": "L-PARKING",
        "regex": "^FLOOR-PARKING$",
        "kind": "parking",
        "meaning": "Common site-related details"
      },
      {
        "id": "L-BF",
        "regex": "^FLOOR-BF\\d*$",
        "kind": "basement",
        "meaning": "Basement floors; FLOOR-BF1, FLOOR-BF2, etc."
      },
      {
        "id": "L-SERVICE",
        "regex": "^FLOOR-SERVICE$",
        "kind": "service",
        "meaning": "Service floor area"
      },
      {
        "id": "L-MF",
        "regex": "^FLOOR-MF(?:GROUND|\\d{2})TO\\d{2,}$",
        "kind": "mezzanine",
        "meaning": "Mezzanine levels, e.g. FLOOR-MFGROUNDTO01, FLOOR-MF01TO02, FLOOR-MF01TO03"
      },
      {
        "id": "L-TERRACE",
        "regex": "^FLOOR-TERRACE$",
        "kind": "terrace",
        "meaning": "Terrace floor objects"
      }
    ],
    "doNotNameLayer": "APPLICABLE FLOOR LAYER",
    "kindMeanings": {
      "applicable_floor": "Any recognized floor layer (numbered floors, ground, parking, basement, service, mezzanine or terrace), wherever the rule specifies applicable_floor."
    }
  },
  "mandatory": [
    {
      "name": "All floors must be labelled",
      "source": "Section 3.0",
      "severity": "error"
    },
    {
      "name": "All blocks must be labelled",
      "source": "Section 3.0",
      "severity": "error"
    },
    {
      "name": "Building use must be provided",
      "source": "Section 3.0",
      "severity": "error"
    }
  ],
  "mandatoryNote": "The manual identifies these as compulsory labels. It lists 'Mandatory requirements' as a Pre-Check error class but does not enumerate other mandatory geometric objects.",
