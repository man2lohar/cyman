    },
    "blockFormat": {
      "template": "BLOCK01, BLOCK02, BLOCK03…… BLOCKnth- Typical",
      "regex": "^BLOCK\\d{2,}(\\s*,\\s*BLOCK\\d{2,})*\\s*-\\s*TYPICAL$",
      "regexFromTemplate": true
    },
    "note": "The manual specifies these text formats but does not provide a formal grammar; regex is an implementation interpretation."
